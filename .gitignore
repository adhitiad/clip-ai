# ──────────────────────────────────────────────
# AI Clipper SaaS — .gitignore
# ──────────────────────────────────────────────

# ── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
pip-wheel-metadata/
share/python-wheels/
.installed.cfg
MANIFEST

# ── Virtual Environment ───────────────────────
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ── Environment Variables & Secrets ──────────
.env
.env.*
!.env.example
!.env.worker.example
*.pem
*.key
secrets.json

# ── Database ──────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Model ML: repo ini TANPA model/training ───
models/*.pkl
models/*.joblib
models/*.h5
models/*.pt
models/*.onnx

# ── Backup & data sensitif ────────────────────
backups/
.data/
youtube_tokens.json
zap-report.md
zap-report.json
zap-report-auth.md
zap-report-auth.json
zap.log
strix_runs/

# ── Media Files (video/audio bisa sangat besar)
temp/
output/
clips/
download/
downloads/
*.mp4
*.mp3
*.wav
*.flac
*.aac
*.mkv
*.avi
*.mov
*.webm
*.m4a
*.m4v

# ── Gambar hasil generate ─────────────────────
*.png
*.jpg
*.jpeg
*.gif
*.webp

# ── Subtitle & Transcript tmp ─────────────────
*.vtt
*.srt
*.sbv

# ── Log Files ─────────────────────────────────
*.log
logs/
*.log.*

# ── IDE & Editor ──────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Testing ───────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# ── Type Checkers ─────────────────────────────
.mypy_cache/
.pyright/
.pyrefly/
.dmypy.json
dmypy.json

# ── Jupyter Notebook ──────────────────────────
.ipynb_checkpoints
*.ipynb

# ── Distribution / Packaging ──────────────────
.Python

# ── Taskiq ────────────────────────────────────
taskiqbeat-schedule
taskiqbeat.pid

# ── Docker ────────────────────────────────────
# .dockerignore DITRACK (dipakai image build)
# Volume Docker tidak disimpan di repo

# ── Frontend (TanStack Start + bun) ──────────
node_modules/
.next/
out/
# bun.lock DITRACK (source of truth frontend)
.taste-skill/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Security toolkit lokal ────────────────────
securities/bin/
securities/uv-tools/
securities/reports/
securities/.download/

# ── README/lisensi milik artefak (bukan dokumentasi repo) ──
# Folder ini sudah diabaikan penuh; pola ini dibuat eksplisit supaya
# README/LICENSE bawaan dependency atau hasil build tidak ikut ter-commit.
temp/**/README*
temp/**/LICENSE*
temp/**/LICENCE*
temp/**/COPYING*
output/**/README*
output/**/LICENSE*
output/**/LICENCE*
output/**/COPYING*
dist/**/README*
dist/**/LICENSE*
dist/**/LICENCE*
dist/**/COPYING*

# ── Misc ──────────────────────────────────────
*.bak
*.tmp
*.temp
.cache/

client_secret**.json
zap-scan.yaml
