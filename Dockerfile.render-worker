# Render worker — konsumen antrean RabbitMQ `shorts-render`.
# Worker TS butuh Bun; render_job.py butuh Python 3.14 + uv + ffmpeg.
# Semua binary memakai glibc bookworm yang sama agar bun bisa dieksekusi.

FROM oven/bun:1.4.2 AS frontend-deps
WORKDIR /app/frontend

# postinstall butuh sumber frontend, jadi salin seluruh direktori.
COPY frontend/ .
RUN bun install --frozen-lockfile --no-cache

FROM python:3.14-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:0.12.11 /uv /uvx /bin/
COPY --from=frontend-deps /usr/local/bin/bun /usr/local/bin/bun

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON_DOWNLOADS=never \
    UV_CACHE_DIR=/tmp/uv-cache \
    HOME=/app \
    PYTHONUNBUFFERED=1 \
    NODE_ENV=production

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ffmpeg \
        libxcb1 libxext6 libgl1 libglib2.0-0 libsm6 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev
COPY . .
RUN uv sync --frozen --no-dev

# node_modules dipasang di image bun glibc yang sama dengan runtime.
WORKDIR /app/frontend
COPY --from=frontend-deps /app/frontend/node_modules ./node_modules
COPY --from=frontend-deps /app/frontend/package.json ./package.json
COPY frontend/bun.lock ./bun.lock
COPY frontend/workers ./workers
COPY frontend/src ./src

# Non-root user untuk CKV_DOCKER_3 + folder runtime yang bisa ditulis.
RUN addgroup --system app && adduser --system --ingroup app app \
    && mkdir -p /app/temp /app/output /app/download /tmp/uv-cache \
    && chown -R app:app /app /tmp/uv-cache
USER 100:101

COPY scripts/container_health.py /app/scripts/container_health.py
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD ["python", "/app/scripts/container_health.py"]

CMD ["bun", "--bun", "run", "worker:render"]
