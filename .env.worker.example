# Template untuk PC worker jarak jauh. Salin ke .env.worker lalu isi dengan
# kredensial unik per PC dan IP LAN broker pusat. Jangan commit file .env.worker.
#
# Password harus URL-safe (huruf/angka, tanpa @ : / ? #).
# Contoh: amqp://worker_kantor1:a1b2c3d4e5f6@10.10.8.166:5672/clip-ai
RABBITMQ_URL=amqp://worker_ganti:ganti_password_url_safe@10.10.8.166:5672/clip-ai
