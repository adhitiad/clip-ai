# --- Google OAuth (login tanpa password) ---
# Dapatkan dari Google Cloud Console. JANGAN men-commit file ini.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=

# --- Auth bridge (server-only, sama dengan backend .env) ---
AUTH_BRIDGE_TOKEN=

# --- Better Auth ---
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=  # Generate: bunx --bun @better-auth/cli secret

# --- YouTube Data API & Scheduler ---
YOUTUBE_DATA_API_KEY=
YOUTUBE_CRON_SECRET=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:3000/api/youtube/oauth/callback
YOUTUBE_TOKEN_ENCRYPTION_KEY=  # 32+ karakter AES-256-GCM

# --- Situs publik (meta SEO / Open Graph) ---
VITE_APP_TITLE=Clip AI
VITE_SITE_URL=http://localhost:3000

# --- Backend URL (di Docker: http://api:8000; di lokal: http://127.0.0.1:8000) ---
SERVER_URL=http://127.0.0.1:8000
# --- RabbitMQ untuk worker render frontend ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
