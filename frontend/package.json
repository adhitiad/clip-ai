{
  "name": "frontend",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "normalize-i18n-docs": "bun scripts/normalize-i18n-docs.mjs",
    "postinstall": "bun scripts/normalize-i18n-docs.mjs",
    "predev": "bun scripts/normalize-i18n-docs.mjs",
    "dev": "vite dev --port 3000",
