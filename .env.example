# ============================================================
# Clip AI — ENVIRONMENT TEMPLATE
# Salin ke .env lalu isi. Dibaca oleh backend/core/env.py:
#   process env (tertinggi) -> backend/.env -> workers/.env -> .env (root)
# API/scripts = load_env("backend"); worker = load_env("workers")
# ============================================================

# --- CORE / WAJIB ---
# Generate: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_a_long_random_secret_key

# --- DATABASE & BROKER ---
# Format: postgresql://[user]:[password]@[host]:[port]/[database_name]
DATABASE_URL=postgresql://postgres:password@localhost:5432/clip_ai
# RabbitMQ (broker Taskiq + antrean shorts-render; tanpa Redis)
# Jangan pakai guest untuk worker lintas PC. Password wajib URL-safe (tanpa @ : / ? #).
RABBITMQ_URL=amqp://clipai:ganti_password_url_safe@IP_BROKER:5672/clip-ai
RABBITMQ_USER=clipai
RABBITMQ_PASSWORD=ganti_password_url_safe_min_32
RABBITMQ_VHOST=clip-ai
# Dipakai container di jaringan Docker (host = rabbitmq, bukan localhost).
RABBITMQ_URL_INTERNAL=amqp://clipai:ganti_password_url_safe_min_32@rabbitmq:5672/clip-ai
# Kosong = auto dari inti fisik: 1 bila 1 core, genap untuk 2+ core; isi angka untuk override
TASKIQ_WORKERS=6

# --- DOCKER COMPOSE (opsional) ---
# Compose memakai image rabbitmq:4-management-alpine + postgres:19.0-alpine3.24.
# Port host digeser agar tidak bentrok dengan layanan lokal lain.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=clip_ai
PG_PORT_HOST=5433
RABBITMQ_PORT_HOST=5672
RABBITMQ_UI_PORT_HOST=15672
# Default 127.0.0.1 = broker hanya bisa diakses dari mesin itu sendiri.
# Set ke IP LAN broker bila worker di PC lain perlu terhubung.
RABBITMQ_BIND_IP=127.0.0.1
RABBITMQ_UI_BIND_IP=127.0.0.1
API_PORT_HOST=8000

# --- SERVER ---
PORT=8000
DEBUG=True
DUB_ALLOWED_ROOT=temp
# Rotasi logs/trace.jsonl & logs/audit.jsonl (bytes, jumlah backup)
LOG_MAX_BYTES=5242880
LOG_BACKUPS=3

# --- SUARA: TTS & STT (terpisah dari LLM) ---
TTS_PROVIDER=auto   # cartesia | camb | gtts | auto
STT_PROVIDER=auto   # camb | openai | groq | auto

# --- AGENT shorts/reels/tiktok (LangChain) ---
# Semua LLM lewat LangChain: openai | gemini | anthropic | openroute | cloudflare |
# grok | meta/muse | glm | minmax | kimi | deepseek | mistral | ollama | dll.
AGENT_PROVIDER=nvidia
AGENT_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# --- API KEY: FITUR AI ---
GROQ_API_KEY=
EXA_API_KEY=
# TTS: Cartesia (primary) + Camb AI (fallback). Kosong keduanya → gTTS gratis.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=ef191366-f52f-447a-a398-ed8c0f2943a1
CARTESIA_MODEL=sonic-3.6
CARTESIA_VERSION=2026-08-14
CAMB_API_KEY=
CAMB_VOICE_ID=147320
CAMB_MODEL=mars-8.1-flash-beta
# Camb AI juga dipakai untuk transkripsi (STT batch); auto = deteksi bahasa
CAMB_STT_LANGUAGE=auto
CAMB_STT_MODE=fast
HUGGINGFACEHUB_API_TOKEN=
# Vector store: embeddings memakai Ollama lokal, bukan HF endpoint.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=clip-ai-hooks
# Dimensi index baru; samakan dengan model embedding Ollama.
# embeddinggemma-2:570m = 768 dimensi; all-minilm = 384 dimensi.
PINECONE_DIMENSION=768
PEXELS_API_KEY=

# --- ACCESS LOG (MongoDB Atlas/eksternal, opsional) ---
# Kosong = access log dinonaktifkan (API tetap jalan normal).
# Format: mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=
MONGODB_DB=clip_ai_access

# --- API KEY PROVIDER VIA LANGCHAIN init_chat_model ---
# NVIDIA NIM (build.nvidia.com) — gratis, format nvapi-...
NVIDIA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRALAI_API_KEY=
OPENROUTER_API_KEY=
CARTESIA_API_KEY=
CAMB_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
MINIMAX_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
META_API_KEY=
OLLAMA_HOST=http://localhost:11434
OLLAMA_API_KEY=
# Embedding offline untuk Pinecone: embeddinggemma-2:570m (768) atau all-minilm (384)
OLLAMA_EMBED_MODEL=embeddinggemma-2:570m

# --- LAINNYA ---
VIRAL_THRESHOLD=6.5
# Opsional: 10 bobot fitur viral, koma-separated, tiap 0.0-3.0; kosong = default
VIRAL_SCORE_WEIGHTS=
DEFAULT_GEO=id

# --- GOOGLE OAUTH (login tanpa password) ---
GOOGLE_CLIENT_ID=
AUTH_BRIDGE_TOKEN=
GOOGLE_CLIENT_SECRET=
# Email yang diizinkan login (koma-separated, 1 user project pribadi)
OWNER_EMAILS=owner@example.com

# --- YOUTUBE DATA API & SCHEDULER ---
# Server-side key, batasi ke YouTube Data API v3 + IP lokal.
YOUTUBE_DATA_API_KEY=
# Bearer secret untuk endpoint scheduler. Generate: openssl rand -hex 32
YOUTUBE_CRON_SECRET=
# OAuth Google terpisah (bukan kredensial login).
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:3000/api/youtube/oauth/callback
# 32+ karakter AES-256-GCM; fallback: PROVIDER_ENCRYPTION_KEY -> SECRET_KEY
YOUTUBE_TOKEN_ENCRYPTION_KEY=

# --- REVENUE (read-only, BUKAN billing) ---
# Opsional: override model saran pendapatan (format provider/model).
# Kosong = ikut AGENT_PROVIDER/AGENT_MODEL (satu jalur LLM teks).
REVENUE_AI_MODEL=
# Opsional: adapter TikTok/Meta saat ini tidak punya API pendapatan publik.
# Isi hanya bila API resmi tersedia; kosong → platform ditandai "Dilewati".
TIKTOK_ACCESS_TOKEN=
META_ACCESS_TOKEN=

# --- STRIPE (mock/roadmap, belum dipakai) ---
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- ZAP scan terautentikasi (opsional) ---
ZAP_JAR=C:\Program Files\ZAP\Zed Attack Proxy\zap-2.17.0.jar
ZAP_SCAN_PORT=8011
